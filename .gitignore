# 本地配置（含 API 密钥），不入库；.env.xxx 变体（如 .env.m0bak 备份）同样是明文密钥
.env
.env.*
!.env.example

# 日志
logs/
*.log

# 本地临时调试产物（Agent/调试导出）
temp.log
temp.json

# SDD 工作区（任务报告/ledger，git 历史为准）
.superpowers/

# Python
__pycache__/
*.py[cod]
.venv/
.venvs/
venv/
dist/
build/
*.egg-info/

# 反面豁免：docs/known-pitfalls/build/ 是"构建与依赖"类问题文档目录，
# 会被上面的 Python 产物规则 `build/` 误伤（git 忽略整个目录后不再下沉匹配）
!docs/known-pitfalls/build/

# 构建产物 / 下载的模型
llama.cpp/
model-gguf/

# IDE
.idea/
.vscode/
.trae/
*.swp
.python-header.yaml
data/

# 引擎 venv 的锁文件：由 modelctl env setup 在目标平台重新解析生成
# （Linux/CUDA 与开发机解析结果不同），故不入库；顶层 uv.lock 不受此规则影响
envs/*/uv.lock

# gateway 子环境锁文件：服务器上 `uv sync --project gateway` 会按本机重新解析改写，
# 与 envs/*/uv.lock 同理不入库（缺失时由 modelctl all/webui 自动 uv sync 重建）
gateway/uv.lock

# dev/integration worktree 工作区
.worktrees/
