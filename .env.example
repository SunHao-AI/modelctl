# ============================================================
# modelctl 多模型部署启动器配置模板
#
# 使用方法：复制为 .env 并修改
#   cp .env.example .env
#
# 配置优先级：profile YAML > 环境变量 > .env > 代码默认值
# 模型级配置（模型路径、端口、并行度、量化等）见 models/*.yaml，
# 本文件仅保留全局配置、存储目录与用量统计服务配置。
# 值含空格或特殊字符时用双引号包裹，例如 FOO="a b c"
# ============================================================

# ---------- 全局配置 ----------
# API 密钥（供 profile 的 ${API_KEY} 插值使用；留空则不校验）
API_KEY=root123456

# ---------- 模型存储目录 ----------
# GGUF 模型根目录（llamacpp 引擎 download 段保存父目录）
MODEL_ROOT=/raid5/sh/model/model-gguf
# ModelScope 下载缓存目录
MODELSCOPE_CACHE=/raid5/sh/model/modelscope
# ollama 模型存储目录
OLLAMA_MODELS=/raid5/sh/model/ollama-models
# HuggingFace 缓存目录（vllm / sglang 引擎）
HF_HOME=/raid5/sh/model/huggingface

# ---------- Unsloth 引擎 ----------
# Unsloth API key（unsloth 引擎必填；健康检查 /v1/models 依赖 Bearer 认证）
UNSLOTH_API_KEY=root123456
# 远程 Unsloth 服务器地址（预留，当前版本未使用；不填则本地无头启动）
UNSLOTH_STUDIO_URL=
# HuggingFace 镜像（unsloth 模型 HF 兜底下载用，如 https://hf-mirror.com）
HF_ENDPOINT=

# ---------- llama.cpp 源码目录（llamacpp 引擎编译用） ----------
LLAMACPP_SOURCE_DIR=/raid5/sh/code/llama.cpp

# ---------- 日志与进程元数据 ----------
# 日志目录（启动日志 launch-<name>.log 与 loguru 运行日志 modelctl.log）
LOG_DIR=/raid5/sh/code/modelctl/data/logs
# PID 文件目录（默认 <项目根>/data/cache，与用量统计缓存一致）
CACHE_DIR=/raid5/sh/code/modelctl/data/cache

# ---------- 用量统计服务 ----------
# 监听地址；统计服务与模型同机部署时建议留空，由 nginx 所在机器访问时设 0.0.0.0
USAGE_HOST=0.0.0.0
# 统计服务监听端口（注意：5001 已被 nginx location / 占用，勿改）
USAGE_PORT=5002
# 数据获取模式：poll=后台定时轮询（默认）；on-demand=由 cc-switch 轮询触发、每次请求同步拉取最新指标
USAGE_MODE=poll
# 轮询间隔（秒）；仅 poll 模式生效
USAGE_POLL_INTERVAL=10
# 用量统计累计数据持久化目录
USAGE_DATA_DIR=/raid5/sh/code/modelctl/data/usage-data
# bench 兜底开关：true=保留"全 0 时 active served 假请求 benchmark"现状（向后兼容）；
# false=stats 全 0 且 gateway collector 无 native 指标时，不再发伪造短请求（对应 vLLM yaml
# enable_per_request_metrics=true + enable_force_include_usage=true 部署场景）
USAGE_BENCH_FALLBACK=true

# ---------- 统一网关（model 参数路由）----------
# 本节点编号（nginx URL 前缀）与 IP（nginx-snippet 生成 map 用）
NODE_ID=210
NODE_HOST=192.168.77.210
# 网关监听地址与端口（B 机 nginx 统一转发 /<node>/llm/v1/ 到 5003）
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=5003
# 未知/缺省 model 的回退模型；同时是一键启停（modelctl all）默认模型标识：
# 填 profile 的 name 或 alias。裸名 qwen3.8 是家族逻辑名（网关按引擎优先级自动
# 路由到当前运行中的 qwen3.8 成员，家族内无成员运行时返回 404）；
# 该裸名同时是 llamacpp 成员 alias，故 modelctl all 也可解析。未设置时回退 deepseek-v4-flash。
GATEWAY_DEFAULT_MODEL=qwen3.8
# 后端转发读超时（秒，与 nginx proxy_read_timeout 对齐）
GATEWAY_READ_TIMEOUT=600

# ---------- 请求级审计日志 ----------
# 审计 JSONL 落盘目录（<DIR>/modelctl-YYYY-MM-DD.jsonl）
AUDIT_DIR=/raid5/sh/code/modelctl/data/audit
# 保留天数（文件名日期 < 今天-该值 的文件删除）；0 = 不按时间清理
AUDIT_RETENTION_DAYS=30
# 总大小上限（MB），超出从最旧删除；0 = 不按大小清理
AUDIT_MAX_SIZE_MB=512
# 定时清理检查间隔（秒），默认 1 天
AUDIT_CLEANUP_INTERVAL=86400
