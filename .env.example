# ============================================================
# modelctl 多模型部署启动器配置模板
#
# 使用方法：复制为 .env 并修改
#   cp .env.example .env
#
# 配置优先级：profile YAML > 环境变量 > .env > 代码默认值
# 模型级配置（模型路径、端口、并行度、量化等）见 models/*.yaml，
# 本文件仅保留全局配置、存储目录与用量统计服务配置。
# 值含空格或特殊字符时用双引号包裹，例如 FOO="a b c"
# ============================================================

# ---------- 全局配置 ----------
# API 密钥（供 profile 的 ${API_KEY} 插值使用；留空则不校验）
API_KEY=root123456

# ---------- 模型存储目录 ----------
# GGUF 模型根目录（llamacpp 引擎 download 段保存父目录）
MODEL_ROOT=/raid5/sh/model/model-gguf
# ModelScope 下载缓存目录
MODELSCOPE_CACHE=/raid5/sh/model/modelscope
# ollama 模型存储目录
OLLAMA_MODELS=/raid5/sh/model/ollama-models
# HuggingFace 缓存目录（vllm / sglang 引擎）
HF_HOME=/raid5/sh/model/huggingface

# ---------- Unsloth 引擎 ----------
# Unsloth API key（unsloth 引擎必填；健康检查 /v1/models 依赖 Bearer 认证）
UNSLOTH_API_KEY=
# 远程 Unsloth 服务器地址（预留，当前版本未使用；不填则本地无头启动）
UNSLOTH_STUDIO_URL=
# HuggingFace 镜像（unsloth 模型 HF 兜底下载用，如 https://hf-mirror.com）
HF_ENDPOINT=

# ---------- llama.cpp 源码目录（llamacpp 引擎编译用） ----------
LLAMACPP_SOURCE_DIR=/raid5/sh/code/llama.cpp

# ---------- 日志目录 ----------
LOG_DIR=/raid5/sh/logs

# ---------- 用量统计服务 ----------
# 监听地址；统计服务与模型同机部署时建议留空，由 nginx 所在机器访问时设 0.0.0.0
USAGE_HOST=0.0.0.0
# 统计服务监听端口（注意：5001 已被 nginx location / 占用，勿改）
USAGE_PORT=5002
# 数据获取模式：poll=后台定时轮询（默认）；on-demand=由 cc-switch 轮询触发、每次请求同步拉取最新指标
USAGE_MODE=poll
# 轮询间隔（秒）；仅 poll 模式生效
USAGE_POLL_INTERVAL=5
# 用量统计累计数据持久化目录
USAGE_DATA_DIR=
