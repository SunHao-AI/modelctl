# ============================================================
# modelctl 多模型部署启动器配置模板
#
# 使用方法：复制为 .env 并修改
#   cp .env.example .env
#
# 配置优先级：profile YAML > 环境变量 > .env > 代码默认值
# 模型级配置（模型路径、端口、并行度、量化等）见 models/*.yaml，
# 本文件仅保留全局配置、存储目录与用量统计服务配置。
# 值含空格或特殊字符时用双引号包裹，例如 FOO="a b c"
# ============================================================

# ---------- 全局配置 ----------
# API 密钥（供 profile 的 ${API_KEY} 插值使用；留空则不校验）
API_KEY=root123456

# ---------- 时区 ----------
# 进程本地时区（IANA 名），留空取默认 Asia/Shanghai。影响 loguru 日志时间戳、
# 审计记录 ts 偏移与按天切分的文件名，并透传给引擎子进程与 docker 容器（vllm /
# tokenspeed / tensorrt_llm 的 docker runtime 会自动注入 -e TZ=）。
# 部署机系统时区多为 UTC，不设置会让日志比预期早 8 小时。非法值回退默认值。
# 注：仅 Linux/macOS 生效（依赖 time.tzset）。Windows 无 tzset 且 UCRT 会把 IANA 名
# 误解析成 +0100，因此本项在 Windows 上被忽略——请改系统时区，勿依赖此处。
TZ=Asia/Shanghai

# ---------- 模型存储目录 ----------
# GGUF 模型根目录（llamacpp 引擎 download 段保存父目录）
MODEL_ROOT=/raid5/sh/model/model-gguf
# ModelScope 下载缓存目录
MODELSCOPE_CACHE=/raid5/sh/model/modelscope
# ollama 模型存储目录
OLLAMA_MODELS=/raid5/sh/model/ollama-models
# HuggingFace 缓存目录（vllm / sglang 引擎）
HF_HOME=/raid5/sh/model/huggingface

# ---------- Unsloth 引擎 ----------
# Unsloth API key（unsloth 引擎必填；健康检查 /v1/models 依赖 Bearer 认证）
UNSLOTH_API_KEY=root123456
# 远程 Unsloth 服务器地址（预留，当前版本未使用；不填则本地无头启动）
UNSLOTH_STUDIO_URL=
# HuggingFace 镜像（unsloth 模型 HF 兜底下载用，如 https://hf-mirror.com）
HF_ENDPOINT=

# ---------- llama.cpp 源码目录（llamacpp 引擎编译用） ----------
LLAMACPP_SOURCE_DIR=/raid5/sh/code/llama.cpp

# ---------- 日志与进程元数据 ----------
# 日志目录（启动日志 launch-<name>.log 与 loguru 运行日志 modelctl.log）
LOG_DIR=/raid5/sh/code/modelctl/data/logs
# PID 文件目录（默认 <项目根>/data/cache，与用量统计缓存一致）
CACHE_DIR=/raid5/sh/code/modelctl/data/cache

# ---------- 用量统计服务 ----------
# 监听地址；统计服务与模型同机部署时建议留空，由 nginx 所在机器访问时设 0.0.0.0
USAGE_HOST=0.0.0.0
# 统计服务监听端口（注意：5001 已被 nginx location / 占用，勿改）
USAGE_PORT=5002
# 数据获取模式：poll=后台定时轮询（默认）；on-demand=由 cc-switch 轮询触发、每次请求同步拉取最新指标
USAGE_MODE=poll
# 轮询间隔（秒）；仅 poll 模式生效。60s 是推荐频率：vLLM 原生滑窗口径 60s，
# 默认值与之对齐（负载低、暴露痛点少）；用户可自定义，但 10s 短期会放大资源占用
USAGE_POLL_INTERVAL=60
# 用量统计累计数据持久化目录
USAGE_DATA_DIR=/raid5/sh/code/modelctl/data/usage-data
# bench 兜底总开关：true=允许 stats 全 0 时 active served 假请求 benchmark（向后兼容）；
# false=stats 全 0 且 gateway collector 无 native 指标时，不再发伪造短请求（对应 vLLM yaml
# enable_per_request_metrics=true + enable_force_include_usage=true 部署场景）
USAGE_BENCH_FALLBACK=true
# ttft 缺口子开关（仅 USAGE_BENCH_FALLBACK=true 时生效）：
#   true（默认）=首 token 时间新缺口也触发 benchmark（有利于 llamacpp 这类缺
#                 原生 ttft 指标引擎的展示）
#   false      = 仅速率字段缺口才触发 benchmark（llamacpp 永远无 ttft 数据）
USAGE_BENCH_TTFT_ONLY=true

# ---------- 统一网关（model 参数路由）----------
# 本节点编号（nginx URL 前缀）与 IP（nginx-snippet 生成 map 用）
NODE_ID=210
NODE_HOST=192.168.77.210
# 网关监听地址与端口（B 机 nginx 统一转发 /<node>/llm/v1/ 到 5003）
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=5003
# 未知/缺省 model 的回退模型；同时是一键启停（modelctl all）默认模型标识：
# 填 profile 的 name 或 alias。裸名 qwen3.8 是家族逻辑名（网关按引擎优先级自动
# 路由到当前运行中的 qwen3.8 成员，家族内无成员运行时返回 404）；
# 该裸名同时是 llamacpp 成员 alias，故 modelctl all 也可解析。未设置时回退 deepseek-v4-flash。
GATEWAY_DEFAULT_MODEL=qwen3.8
# 后端转发读超时（秒，与 nginx proxy_read_timeout 对齐）
GATEWAY_READ_TIMEOUT=600

# ---------- Web 管理控制台（modelctl webui）----------
# 启动：modelctl webui start|stop|restart|status（可选 --port/--host 临时覆盖下面两项）
# 访问：浏览器打开 http://<WEBUI_HOST>:<WEBUI_PORT>/，登录框填上面的 API_KEY
# 监听地址：默认 127.0.0.1（管理 API 无细粒度鉴权，勿随意暴露公网；远程访问走 nginx/SSH 隧道）
WEBUI_HOST=127.0.0.1
# 监听端口：CLI --port 可临时覆盖；前端 dev（vite 5173）的 /admin/api 代理读同一值
# 与 GATEWAY_PORT（5003）互不冲突，gateway 与 webui 可同时运行
WEBUI_PORT=4173
# 前端产物目录：npm run build 输出到项目根 dist/（webui 自动挂载为 SPA，路径固定无需配置）
# 缺失时 webui 仍可用，只是仅暴露 /admin/api 与 /v1，浏览器访问根路径会 404

# ---------- 请求级审计日志 ----------
# 审计 JSONL 落盘目录（<DIR>/modelctl-YYYY-MM-DD.jsonl）
AUDIT_DIR=/raid5/sh/code/modelctl/data/audit
# 保留天数（文件名日期 < 今天-该值 的文件删除）；0 = 不按时间清理
AUDIT_RETENTION_DAYS=30
# 总大小上限（MB），超出从最旧删除；0 = 不按大小清理
AUDIT_MAX_SIZE_MB=512
# 定时清理检查间隔（秒），默认 1 天
AUDIT_CLEANUP_INTERVAL=86400

# ── 集群（分布式管理面，设计文档 docs/superpowers/specs/2026-09-03-modelctl-cluster-design.md）──
# 角色：solo(默认,单机) | worker(仅注册中心) | control-plane(仅中心) | both(中心且自跑模型)
# CLUSTER_ROLE=solo
# 中心地址（worker join 后写入；scheme 用 http，WS 自动推导 ws）
# CLUSTER_CENTER_URL=http://192.168.77.210:4173
# 本节点在集群内的唯一标识（modelctl cluster join 写入）
# CLUSTER_NODE_ID=w-210
# 所属局域网标签（仅展示/分组用）
# CLUSTER_LAN=lan-2
# 心跳间隔秒 / 租约秒（中心按 lease 过期判 stale，last_seen 超 3×lease 判 offline）
# CLUSTER_HEARTBEAT_INTERVAL_S=10
# CLUSTER_LEASE_S=90
# 裸 ws:// 传输（仅内网调试用；默认 ws(s) 跟随 center_url scheme）
# CLUSTER_WS_INSECURE=0
# 集群准入令牌（中心 modelctl cluster init 生成，cluster join 时消费）
# CLUSTER_JOIN_TOKEN=
# 节点专属令牌（join 成功后由中心签发并自动写回本文件；重连用它，可单独吊销）
# CLUSTER_NODE_TOKEN=
